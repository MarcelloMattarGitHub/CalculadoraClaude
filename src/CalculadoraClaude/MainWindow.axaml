<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CalculadoraClaude.MainWindow"
        Title="CalculadoraClaude"
        Width="320" Height="460"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style Selector="Button.op">
            <Setter Property="Background" Value="#E8892B" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,*,*,*,*" ColumnDefinitions="*,*,*,*" Margin="8">
        <TextBlock x:Name="Visor" Grid.ColumnSpan="4" Text="0"
                   FontSize="44" HorizontalAlignment="Right"
                   VerticalAlignment="Center" Margin="8,16" />

        <Button Grid.Row="1" Grid.Column="0" Content="C" Click="OnLimpar" />
        <Button Grid.Row="1" Grid.Column="1" Content="±" Click="OnSinal" />
        <Button Grid.Row="1" Grid.Column="2" Content="%" Click="OnPorcento" />
        <Button Grid.Row="1" Grid.Column="3" Content="÷" Classes="op" Click="OnOperador" />

        <Button Grid.Row="2" Grid.Column="0" Content="7" Click="OnDigito" />
        <Button Grid.Row="2" Grid.Column="1" Content="8" Click="OnDigito" />
        <Button Grid.Row="2" Grid.Column="2" Content="9" Click="OnDigito" />
        <Button Grid.Row="2" Grid.Column="3" Content="×" Classes="op" Click="OnOperador" />

        <Button Grid.Row="3" Grid.Column="0" Content="4" Click="OnDigito" />
        <Button Grid.Row="3" Grid.Column="1" Content="5" Click="OnDigito" />
        <Button Grid.Row="3" Grid.Column="2" Content="6" Click="OnDigito" />
        <Button Grid.Row="3" Grid.Column="3" Content="-" Classes="op" Click="OnOperador" />

        <Button Grid.Row="4" Grid.Column="0" Content="1" Click="OnDigito" />
        <Button Grid.Row="4" Grid.Column="1" Content="2" Click="OnDigito" />
        <Button Grid.Row="4" Grid.Column="2" Content="3" Click="OnDigito" />
        <Button Grid.Row="4" Grid.Column="3" Content="+" Classes="op" Click="OnOperador" />

        <Button Grid.Row="5" Grid.Column="0" Content="0" Click="OnDigito" />
        <Button Grid.Row="5" Grid.Column="1" Content="," Click="OnVirgula" />
        <Button Grid.Row="5" Grid.Column="2" Content="⌫" Click="OnApagar" />
        <Button Grid.Row="5" Grid.Column="3" Content="=" Classes="op" Click="OnIgual" />
    </Grid>
</Window>
